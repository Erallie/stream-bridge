[Unit]
Description=StreamBridge cross-platform Discord chat bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/opt/stream-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stream-bridge/bot-env/bin/python -m streambridge
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
