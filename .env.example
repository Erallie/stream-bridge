TWITCH_REFRESH_TOKEN=

# Direct YouTube: Desktop OAuth application plus renewable channel authorization.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Direct Kick: developer application plus renewable user authorization.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REFRESH_TOKEN=
