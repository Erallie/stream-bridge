# Required Discord application credentials.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register commands instantly in one development server.
DISCORD_GUILD_ID=

# Optional SSN settings. The shown defaults normally need no changes.
SSN_WEBSOCKET_URL=wss://io.socialstream.ninja
# Optional: seconds between SSN host checks and seconds to wait for each response.
SSN_HOST_PROBE_INTERVAL=15
SSN_HOST_PROBE_TIMEOUT=10

# Optional storage and logging settings. The shown values are the defaults.
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=INFO
# Optional: remove older duplicate/delivery history during daily maintenance.
HISTORY_RETENTION_DAYS=30
OAUTH_STATE_PATH=./data/oauth_tokens.json

# Optional direct Twitch integration. All four values are required when Twitch is enabled.
TWITCH_BOT_USERNAME=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# Optional direct YouTube integration. The app credentials and public callback are required;
# each Discord server authorizes its own YouTube channel with /direct youtube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://ninjabridge-webhook.gozarproductions.com/youtube/oauth/callback
YOUTUBE_OAUTH_CALLBACK_PATH=/youtube/oauth/callback

# Optional direct Kick integration. The client ID, client secret, redirect URI, and encryption
# key are required when Kick is enabled. Each Discord server then uses /direct kick.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_OAUTH_REDIRECT_URI=https://ninjabridge-webhook.gozarproductions.com/kick/oauth/callback
# Generate once with: python -m ninjabridge.keygen. This encrypts all per-server OAuth tokens.
TOKEN_ENCRYPTION_KEY=
# Optional local-listener settings. The shown values are the defaults. If you change the port
# or paths, make the same changes in your installed Cloudflare Tunnel configuration.
KICK_WEBHOOK_HOST=127.0.0.1
KICK_WEBHOOK_PORT=8765
KICK_WEBHOOK_PATH=/kick/webhook
KICK_OAUTH_CALLBACK_PATH=/kick/oauth/callback
