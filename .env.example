DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one development server.
DISCORD_GUILD_ID=

# Optional Social Stream Ninja connection. The default URL normally needs no change.
SSN_WEBSOCKET_URL=wss://io.socialstream.ninja
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=INFO
# Duplicate/delivery history older than this is removed at startup and every 24 hours.
HISTORY_RETENTION_DAYS=30
OAUTH_STATE_PATH=./data/oauth_tokens.json

# Direct Twitch: bot account name plus renewable user authorization.
TWITCH_BOT_USERNAME=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# Direct YouTube: Desktop OAuth application plus renewable channel authorization.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Shared Kick application. Each Discord server authorizes its own broadcaster with /direct kick.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_OAUTH_REDIRECT_URI=https://kick-webhook.gozarproductions.com/kick/oauth/callback
# Generate once with: python -m ninjabridge.keygen
KICK_TOKEN_ENCRYPTION_KEY=
