# Required Discord application credentials.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Required only when the web dashboard offers Discord sign-in/account linking.
DISCORD_CLIENT_SECRET=

# Optional: register commands instantly in one development server.
DISCORD_GUILD_ID=

# Optional SSN settings. The shown defaults normally need no changes.
SSN_WEBSOCKET_URL=wss://io.socialstream.ninja
# Optional: seconds between SSN host checks and seconds to wait for each response.
SSN_HOST_PROBE_INTERVAL=15
SSN_HOST_PROBE_TIMEOUT=10

# Optional storage and logging settings. The shown values are the defaults.
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=INFO
# Optional: remove older duplicate/delivery history during daily maintenance.
HISTORY_RETENTION_DAYS=30
# Optional direct Twitch integration. Users authorize through the dashboard.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional direct YouTube integration. Users authorize through the dashboard.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: seconds between checks while an authorized YouTube channel is not live.
YOUTUBE_DISCOVERY_INTERVAL=300

# Optional direct Kick integration. Users authorize through the dashboard.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Generate once with: python -m streambridge.keygen. This encrypts linked-account OAuth tokens.
TOKEN_ENCRYPTION_KEY=
# Optional shared webhook/dashboard listener settings. The shown values are the defaults.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
KICK_WEBHOOK_PATH=/kick/webhook

# Optional web dashboard. The site is static; authentication, secrets, and settings stay in
# this Pi-hosted API. Add every exact website origin that may call it, separated by commas.
DASHBOARD_SITE_URL=https://YOUR_GITHUB_NAME.github.io/stream-bridge-website
DASHBOARD_ALLOWED_ORIGINS=https://YOUR_GITHUB_NAME.github.io,https://YOUR_CUSTOM_DOMAIN
DASHBOARD_API_PUBLIC_URL=https://streambridge-webhook.YOUR_DOMAIN
